# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# Database (Docker Compose default). Use 127.0.0.1 on Windows: localhost can resolve to ::1.
DATABASE_URL="postgresql://meridian:meridian@127.0.0.1:5432/meridian?schema=public&sslmode=disable"

# Auth.js / NextAuth
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3001
# Optional demo admin bootstrap (used by seed)
SEED_ADMIN_EMAIL=admin@meridian.local
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
SEED_USER_EMAIL=user@meridian.local
SEED_USER_PASSWORD=User123!ChangeMe

# Stripe — run `npm run stripe:setup` to paste the three real values and verify.
# Replace ALL THREE placeholders to switch checkout from demo mode to real
# Stripe Checkout. Leaving any one as a placeholder keeps demo mode on, so
# adding keys one at a time can never leave a paid booking unconfirmed.
# After editing, restart `npm run dev` and check GET /api/checkout ("mode":"live").
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Production demos only: explicitly allow the local demo confirmation flow
# without real Stripe keys. Leave unset (false) for real deployments.
# ALLOW_DEMO_CHECKOUT=true

# Realtime (optional; leave unset to use polling fallback)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Seat holds
SEAT_HOLD_MINUTES=10
